# Server settings (read by server/src/config.js)
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/adda_khana
# Signs login cookies. Use a long random value (openssl rand -hex 32); the server
# refuses to start in production with this example value or anything short.
JWT_SECRET=change-me-to-a-long-random-string
# Port the API and Socket.IO listen on (and, in production, the whole app)
PORT=4080
NODE_ENV=development

# Cloudflare Realtime TURN: create a TURN key in the Cloudflare dashboard (Realtime > TURN)
# or via the API, and paste its ID and API token here.
CF_TURN_KEY_ID=
CF_TURN_KEY_API_TOKEN=
# Set to true to send all call audio through TURN (hides IP addresses between users).
FORCE_TURN_RELAY=false

# Optional: a different TURN server instead of Cloudflare (comma-separate multiple URLs)
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Watch together: finding videos on web pages.
# Site support comes from yt-dlp: install it with `npm run setup:yt-dlp` (or set YTDLP_PATH).
YTDLP_PATH=
# Open pages in a hidden browser when nothing else finds a video (needs Playwright's Chromium).
DEEP_SCAN=true
# The server won't fetch from private/local addresses (your machine, LAN, cloud metadata).
# Set to true only to relay videos from your own network, e.g. a NAS.
STREAM_ALLOW_PRIVATE=false
# Relayed video files are fetched once and shared by every viewer (disk cap in GB; 0 = off).
STREAM_CACHE_GB=10
# Most connections per relayed file. Extra ones are only opened while they make the
# download faster (sites that limit each connection), like a download manager. 1 = off.
STREAM_CONNECTIONS=4
# FFmpeg joins sites' separate picture and sound files (install with `npm run setup:ffmpeg`, or set a path).
FFMPEG_PATH=

# Live streams from an admin's device go from their browser to each viewer separately,
# so their upload speed and computer decide how many can watch (most 30).
LIVE_MAX_VIEWERS=10

# Photos, files and voice messages: where they're kept and the largest allowed upload.
UPLOAD_DIR=
UPLOAD_MAX_MB=25

# Host admin: created on first start if there isn't one. With the defaults you
# log in as admin / admin and are asked to change the password (a password of
# "admin" or under 8 characters always has to be changed). Forgot it?
# Run `npm run admin:reset`.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Security. TRUST_PROXY: which proxies may report the visitor's address (default:
# one on this machine, like nginx; set 1 if your proxy runs elsewhere).
# ALLOWED_ORIGINS: other web addresses (comma-separated) allowed to use the app,
# only needed if the app is reached under a different address than it runs on.
TRUST_PROXY=
ALLOWED_ORIGINS=

# Push notifications for the Android app (Firebase Cloud Messaging): the Firebase
# project's service account key, as a path to the JSON file or the JSON itself.
# Empty: no push notifications. Setup steps: android/README.md.
FCM_SERVICE_ACCOUNT=

# Android App Links: room invite links (/join/…) open straight in the Android
# app when this matches the SHA-256 fingerprint of the key the app is signed
# with (apksigner verify --print-certs). Empty: the fingerprint of the key in
# android/keystore. Several, comma-separated, if you sign with more than one.
ANDROID_CERT_SHA256=
